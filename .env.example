COMPOSE_PROJECT_NAME=seclab-sbf
# El perfil lo fija la imagen que se levanta (light o full). Se deja
# light por defecto; los atajos make lab-ssh-full y lab-ssh-cloud-full
# lo ajustan solos a full.
WORKSPACE_DIR=./workspace
# Tailnet del host cloud. Con esto los atajos lab-ssh-cloud-* ya no
# necesitan TF_HOST en la linea de comandos.
CLOUD_HOST=
CLOUD_REPO_DIR=~/seclab-sbf
CLOUD_WORKSPACE_DIR=/opt/seclab-sbf/workspace
LAB_ENV_FILE=.env
LAB_CPUS=2.0
LAB_MEMORY_LIMIT=1g
LAB_PIDS_LIMIT=256
VPN_DIR=./vpn
VPN_MODE=inside
TTYD_USER=tester
TTYD_PASSWORD=
TTYD_INTERFACE=0.0.0.0
TTYD_PORT=7681
SSH_USER=tester
SSH_PORT=2222
SSH_PUBLIC_KEY=
VPNTRY_CONFIG=/vpn/tryhackme.ovpn
VPNHTB_CONFIG=/vpn/hackthebox.ovpn
VPNCLI_CONFIG=/vpn/client.ovpn
# Credenciales de los perfiles que piden usuario. Opcionales: si el .ovpn
# ya trae un bloque <auth-user-pass> inline, no hacen falta. Se inyectan en
# un archivo 600 en el volumen y se borran al desconectar.
VPNTRY_USER=
VPNTRY_PASSWORD=
VPNHTB_USER=
VPNHTB_PASSWORD=
VPNCLI_USER=
VPNCLI_PASSWORD=
TZ=UTC
LANG=C.UTF-8
