# Bootstrap cloud de seclab-sbf. NO versionar con valores reales.
# Este archivo es plantilla: copia a deploy/.env y completa fuera de Git.
# Nunca pongas aquí el .env de ejecución del laboratorio.

# Tailscale: auth key one-off, etiquetada, preaprobada y expiración corta.
# Se usa UNA vez por consola en el host y se revoca (ver security/tailscale/README.md).
TAILSCALE_AUTHKEY=

# DigitalOcean: token API para terraform (alternativa: TF_VAR_do_token).
# Dejar vacío si el stack no es DO.
TF_VAR_do_token=
