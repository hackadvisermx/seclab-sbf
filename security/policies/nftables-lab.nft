define SECLAB_DOCKER_CIDR = 172.20.0.0/16
define SECLAB_DOCKER_CIDR6 = fd00::/8
define SECLAB_DOCKER_GATEWAY = 172.20.0.1
define SECLAB_TAILSCALE4 = 100.64.0.0/10
define SECLAB_TAILSCALE6 = fd7a:115c:a1e0::/48
define SECLAB_METADATA4 = 169.254.169.254
define SECLAB_AZURE4 = 168.63.129.16
define SECLAB_ORACLE4 = 192.0.0.192
define SECLAB_METADATA6 = fd00:ec2::254

table inet seclab_security {
  chain prerouting {
    type filter hook prerouting priority -300; policy accept;
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 127.0.0.0/8 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 169.254.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr $SECLAB_TAILSCALE4 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr $SECLAB_METADATA4 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr $SECLAB_AZURE4 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr $SECLAB_ORACLE4 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr $SECLAB_DOCKER_GATEWAY drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.17.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.18.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.19.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.20.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.21.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.22.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.23.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.24.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.25.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.26.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.27.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.28.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.29.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.30.0.0/16 drop
    ip saddr $SECLAB_DOCKER_CIDR ip daddr 172.31.0.0/16 drop
    ip6 saddr $SECLAB_DOCKER_CIDR6 ip6 daddr $SECLAB_DOCKER_CIDR6 drop
    ip6 saddr $SECLAB_DOCKER_CIDR6 ip6 daddr fe80::/10 drop
    ip6 saddr $SECLAB_DOCKER_CIDR6 ip6 daddr $SECLAB_TAILSCALE6 drop
    ip6 saddr $SECLAB_DOCKER_CIDR6 ip6 daddr $SECLAB_METADATA6 drop
  }
}

# ---------------------------------------------------------------------------
# INPUT del HOST. Aqui esta la garantia de "sin IP publica = sin acceso".
#
# El 2026-10-10 la instancia paso a llevar IP publica efimera en la VNIC,
# porque los limites del compartment no permiten ni NAT gateway
# (nat-gateway-count = 0) ni un internet gateway propio
# (internet-gateway-count = 1, ya usado). OCI filtra el ingress en el NSG y
# en la security list, y los dos los pone este stack solo con reglas de
# egress. Esta tabla es la tercera capa y la que no depende de nadie: aunque
# alguien anadiera una regla de ingress en el NSG por error, aqui sigue sin
# entrar nada.
#
# NO hay reglas por puerto. Ni 22, ni 2222, ni 7681. Todo lo que no sea
# loopback, Tailscale o respuesta de una conexion ya establecida, se tira.
# El acceso al laboratorio es por el tailnet y por nada mas.
#
# La cadena forward NO se toca: la gestiona Docker para sus bridges, y
# mezclarse con ella rompe el DNS interno del contenedor.

table inet seclab_host {
  chain input {
    type filter hook input priority -10; policy drop;

    # Respuestas de conexiones que ya salimos. Sin esto, Tailscale no
    # completaria el handshake con DERP ni el NAT traversal, y se caeria al
    # DROP de abajo. Es la unica excepcion de la tabla.
    ct state established,related accept

    # Loopback.
    iif "lo" accept

    # Tailscale. La interfaz no existe todavia cuando se carga la politica,
    # y eso es correcto: nftables solo compara el nombre cuando llega un
    # paquete, y para entonces tailscaled ya la ha creado. Si el host no
    # tiene Tailscale, esta regla simplemente nunca casa y no hace falta.
    iifname "tailscale0" accept

    # DHCP de la VNIC. Sin esto la interfaz pierde su direccion y el host
    # se queda sin salida. No es un puerto de servicio: es el lease.
    udp sport 67 udp dport 68 accept

    # PMTU y unreachable de ICMP. Sin esto, un paquete con MTU mayor que el
    # camino genera ICMP que se descarta, el emisor reintenta para siempre y
    # las descargas grandes se quedan colgadas.
    icmp type destination-unreachable accept
    icmp type time-exceeded accept
    icmp type parameter-problem accept
    icmpv6 type destination-unreachable accept
    icmpv6 type packet-too-big accept
    icmpv6 type time-exceeded accept
    icmpv6 type parameter-problem accept
    icmpv6 type { echo-request, echo-reply } accept
  }

  # El output no se filtra: el host tiene que poder instalar, actualizar y
  # hablar con el registro de imagen. La politica defensiva de este proyecto
  # esta en el NSG y en el isolation del contenedor, no en cortar la salida.
}
