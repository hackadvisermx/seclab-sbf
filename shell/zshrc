export SECLAB_STATE_DIR="${SECLAB_STATE_DIR:-/var/lib/seclab/tester}"
export TERM="${TERM:-xterm-256color}"
export SECLAB_TOOLS_FILE="${SECLAB_TOOLS_FILE:-/usr/local/share/seclab/tools.json}"
# sshd reemplaza el PATH de la sesion por su propia lista, asi que el
# ruby de la imagen full (usado por msfconsole/msfvenom) no llega al
# login. Se antepone aqui solo si existe.
if [ -d /opt/ruby/bin ]; then
  export PATH="/opt/ruby/bin:$PATH"
fi

# Aterriza en el workspace, que es donde se trabaja y donde vive el material.
#
# Sin esto, entrar por SSH o por ttyd deja la sesion en $HOME
# (/home/tester), que es un home normal y no el sitio donde esta el
# trabajo. `working_dir: /workspace` del compose y el WORKDIR de la imagen
# solo cubren `docker exec` y los comandos que se lanzan con un workdir, NO
# un login de shell: ahi manda el directorio de inicio del usuario.
#
# Va aqui, al principio y no al final, a proposito. Todo lo que viene
# despues lo hereda: el `exec tmux new-session` de mas abajo crea la
# sesion con este cwd, asi que las ventanas nuevas y `new-session` sin -c
# abren en el workspace. Ponerlo al final dejaria la sesion de tmux en
# /home/tester aunque este login acabase bien.
if [[ -d /workspace && -w /workspace ]]; then
  cd /workspace
fi
export ZSH="/opt/seclab/oh-my-zsh"
export ZSH_CUSTOM="$ZSH/custom"
export ZSH_CACHE_DIR="$SECLAB_STATE_DIR/oh-my-zsh-cache"
export ZSH_THEME="${ZSH_THEME:-robbyrussell}"
export HISTFILE="$SECLAB_STATE_DIR/.zsh_history"
export HISTSIZE=50000
export SAVEHIST=50000
export _ZO_DATA_DIR="$SECLAB_STATE_DIR/zoxide"
plugins=(
  git
  tmux
  ssh
  extract
  history
  aliases
  jsontools
  zsh-completions
  pentest-lab
)

if [[ -t 0 && -t 1 ]]; then
  plugins+=(zsh-autosuggestions)
fi

if (( $+commands[zoxide] )); then
  plugins+=(zoxide)
fi

if [[ -t 0 && -t 1 ]]; then
  plugins+=(zsh-syntax-highlighting)
fi

source "$ZSH/oh-my-zsh.sh"

if [[ -t 0 && -t 1 ]] && (( $+commands[fzf] )); then
  eval "$(fzf --zsh)"
fi

if [[ -o interactive && -z "${TMUX:-}" && ( -n "${SSH_CONNECTION:-}" || "${SECLAB_TMUX:-0}" == "1" ) ]]; then
  exec /usr/bin/tmux new-session -A -s pentest-lab /usr/bin/zsh -il
fi

if (( $+functions[pt-banner] )); then
  pt-banner
fi
