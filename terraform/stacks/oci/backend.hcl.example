# Backend nativo OCI (Object Storage via API, sin S3). Sin secretos aquí:
# auth por ~/.oci/config (config_file_profile) o variables del provider.
# El bucket y la ruta se definen en deploy/backend-oci.hcl (ignorado).
# Nota: el backend "s3" falla con Terraform >= 1.16 contra OCI
# (501 AWS chunked encoding not supported); por eso el stack OCI usa
# el backend nativo. Azure/DO quedan diferidas.
bucket              = "REEMPLAZAR-bucket-state"
namespace           = "REEMPLAZAR-namespace"
key                 = "seclab-sbf/oci/terraform.tfstate"
region              = "mx-monterrey-1"
config_file_profile = "DEFAULT"
